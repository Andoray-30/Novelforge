# NovelForge backend configuration template.
# Copy this file to novelforge-core/.env and fill real values locally.
# Never commit .env or real API keys.

# ------------------------------------------------------------------------------
# Provider (OpenAI-compatible)
# ------------------------------------------------------------------------------
# MVP default: SiliconFlow + DeepSeek-V4-Flash (single provider mode).
# Change OPENAI_BASE_URL / OPENAI_MODEL to switch provider.
OPENAI_API_KEY=replace-with-server-side-key
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_MODEL=deepseek-ai/DeepSeek-V4-Flash
NOVELFORGE_FAST_MODEL=deepseek-ai/DeepSeek-V4-Flash
NOVELFORGE_PRO_MODEL=deepseek-ai/DeepSeek-V4-Flash
NOVELFORGE_DEFAULT_AI_MODE=fast
OPENAI_FALLBACK_MODELS=
OPENAI_STRICT_MODEL=false
NOVELFORGE_OPENAI_PROXY=

# ------------------------------------------------------------------------------
# Model router & health routing
# ------------------------------------------------------------------------------
NOVELFORGE_ENABLE_MODEL_ROUTER=true
NOVELFORGE_ENABLE_MODEL_HEALTH_ROUTING=true
NOVELFORGE_MODEL_HEALTH_ROUTING_LIMIT=200
NOVELFORGE_MODEL_PROBE_TIMEOUT=25
NOVELFORGE_MODEL_COOLDOWN_SECONDS=180

# ------------------------------------------------------------------------------
# Profile routing (off by default)
# ------------------------------------------------------------------------------
NOVELFORGE_ENABLE_PROFILE_ROUTING=false
NOVELFORGE_PROFILE_ROUTING_MIN_CONFIDENCE=medium
NOVELFORGE_PROFILE_ROUTING_SCOPE=session
NOVELFORGE_PROFILE_ROUTING_ALLOW_LOW_CONFIDENCE=false

# ------------------------------------------------------------------------------
# Model candidate pools (comma-separated)
# ------------------------------------------------------------------------------
NOVELFORGE_EXTRACTOR_FAST_MODELS=deepseek-ai/DeepSeek-V4-Flash
NOVELFORGE_EXTRACTOR_DEEP_MODELS=deepseek-ai/DeepSeek-V4-Flash
NOVELFORGE_EXTRACTOR_REPAIR_MODELS=deepseek-ai/DeepSeek-V4-Flash
NOVELFORGE_WRITER_FAST_MODELS=deepseek-ai/DeepSeek-V4-Flash
NOVELFORGE_WRITER_PRO_MODELS=deepseek-ai/DeepSeek-V4-Flash
NOVELFORGE_JUDGE_MODELS=deepseek-ai/DeepSeek-V4-Flash
NOVELFORGE_SCHEMA_REPAIR_MODELS=deepseek-ai/DeepSeek-V4-Flash

# ------------------------------------------------------------------------------
# Role runtime settings
# Each role supports: _TIMEOUT, _CONCURRENCY, _CHUNK_SIZE, _MAX_TOKENS
# ------------------------------------------------------------------------------

# extractor_fast: long-form extraction workhorse.
# Q.2.3 recommendation: concurrency=1, timeout=300, max_tokens=3500.
NOVELFORGE_EXTRACTOR_FAST_TIMEOUT=300
NOVELFORGE_EXTRACTOR_FAST_CONCURRENCY=1
NOVELFORGE_EXTRACTOR_FAST_CHUNK_SIZE=2500
NOVELFORGE_EXTRACTOR_FAST_MAX_TOKENS=3500

# extractor_deep: slow/high-quality model, low concurrency.
NOVELFORGE_EXTRACTOR_DEEP_TIMEOUT=420
NOVELFORGE_EXTRACTOR_DEEP_CONCURRENCY=1
NOVELFORGE_EXTRACTOR_DEEP_CHUNK_SIZE=1800
NOVELFORGE_EXTRACTOR_DEEP_MAX_TOKENS=4000

# extractor_repair: repair/fix extraction errors.
NOVELFORGE_EXTRACTOR_REPAIR_TIMEOUT=300
NOVELFORGE_EXTRACTOR_REPAIR_CONCURRENCY=2
NOVELFORGE_EXTRACTOR_REPAIR_CHUNK_SIZE=2000
NOVELFORGE_EXTRACTOR_REPAIR_MAX_TOKENS=3000

# writer_fast / writer_pro: AI writing roles.
NOVELFORGE_WRITER_FAST_TIMEOUT=120
NOVELFORGE_WRITER_FAST_CONCURRENCY=3
NOVELFORGE_WRITER_FAST_CHUNK_SIZE=4000
NOVELFORGE_WRITER_FAST_MAX_TOKENS=3000
NOVELFORGE_WRITER_PRO_TIMEOUT=420
NOVELFORGE_WRITER_PRO_CONCURRENCY=1
NOVELFORGE_WRITER_PRO_CHUNK_SIZE=6000
NOVELFORGE_WRITER_PRO_MAX_TOKENS=6000

# judge: quality evaluation role.
NOVELFORGE_JUDGE_TIMEOUT=240
NOVELFORGE_JUDGE_CONCURRENCY=2
NOVELFORGE_JUDGE_CHUNK_SIZE=4000
NOVELFORGE_JUDGE_MAX_TOKENS=3000

# schema_repair: JSON schema repair role.
NOVELFORGE_SCHEMA_REPAIR_TIMEOUT=120
NOVELFORGE_SCHEMA_REPAIR_CONCURRENCY=2
NOVELFORGE_SCHEMA_REPAIR_CHUNK_SIZE=4000
NOVELFORGE_SCHEMA_REPAIR_MAX_TOKENS=4000

# Import chapter split. Q.2.3 recommendation: 12000 chars per system split.
NOVELFORGE_IMPORT_CHAPTER_MAX_CHARS=12000

# ------------------------------------------------------------------------------
# Schema repair feature flags
# ------------------------------------------------------------------------------
ENABLE_SCHEMA_REPAIR=true
ENABLE_MODEL_SCHEMA_REPAIR=false

# ------------------------------------------------------------------------------
# Temperature & retry
# ------------------------------------------------------------------------------
EXTRACTION_TEMPERATURE=0.3
CREATIVE_TEMPERATURE=0.8
RETRY_DELAY=1.0

# ------------------------------------------------------------------------------
# Concurrency & rate limiting
# ------------------------------------------------------------------------------
MIN_CONCURRENCY=2
MAX_CONCURRENCY=10
TARGET_SUCCESS_RATE=0.95
TARGET_RESPONSE_TIME=5.0
RPM_LIMIT=500
TPM_LIMIT=2000000

# ------------------------------------------------------------------------------
# Retry
# ------------------------------------------------------------------------------
MAX_RETRIES=5
RETRY_BASE_DELAY=2.0
RETRY_MAX_DELAY=120.0

# ------------------------------------------------------------------------------
# Storage
# ------------------------------------------------------------------------------
NOVELFORGE_DATA_DIR=./data
STORAGE_TYPE=content_db
USE_CONTENT_DATABASE=true
FILE_STORAGE_DIR=./data/file_storage
DATABASE_PATH=./data/novelforge.db
CONTENT_DATABASE_PATH=./data/novelforge_content.db

# ------------------------------------------------------------------------------
# Extraction limits
# ------------------------------------------------------------------------------
MAX_TEXT_LENGTH=500000
MAX_CHARACTERS=20

# ------------------------------------------------------------------------------
# SillyTavern integration (optional)
# ------------------------------------------------------------------------------
# SILLYTAVERN_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Security & deployment
# ------------------------------------------------------------------------------
# Local development: leave auth disabled (defaults).
# Internal / public deployment: set a strong admin password and a long random
# session secret. The public flag enables single-admin login, HttpOnly Cookie
# session, and disables runtime OpenAI key overrides.
NOVELFORGE_PUBLIC_DEPLOYMENT=false
NOVELFORGE_AUTH_REQUIRED=false
NOVELFORGE_ADMIN_PASSWORD=change-this-password
NOVELFORGE_SESSION_SECRET=replace-with-a-long-random-string
FRONTEND_ORIGIN=http://localhost:3000
NOVELFORGE_ALLOW_RUNTIME_OPENAI_OVERRIDES=true

# Cookie behavior (automatic, not directly configurable):
# - HttpOnly cookie for session
# - secure=true when NOVELFORGE_PUBLIC_DEPLOYMENT=true
# - SameSite=Lax

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=
STRUCTURED_LOGGING=true

# ------------------------------------------------------------------------------
# Development / testing
# ------------------------------------------------------------------------------
# Set to true to mock AI tool calls for offline testing (never use in production).
NOVELFORGE_MOCK_TOOL_CALLS=false
