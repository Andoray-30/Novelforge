# NovelForge backend configuration template.
# Copy this file to novelforge-core/.env and fill real values locally.
# Never commit .env or real API keys.

# OpenAI-compatible provider, for example NewAPI.
# Keep real keys in novelforge-core/.env or host secrets only.
OPENAI_API_KEY=replace-with-server-side-key
OPENAI_BASE_URL=https://fast-newapi.sync-api.xyz:8848/v1
OPENAI_MODEL=gemini-3.5-flash
NOVELFORGE_FAST_MODEL=gemini-3.5-flash
NOVELFORGE_PRO_MODEL=gemini-3.1-pro-preview
NOVELFORGE_DEFAULT_AI_MODE=fast
OPENAI_FALLBACK_MODELS=
OPENAI_STRICT_MODEL=false
NOVELFORGE_OPENAI_PROXY=

# Runtime model routing. These are candidate pools, not hard-coded winners.
# The backend probes candidates for the current task and records the selected route.
NOVELFORGE_ENABLE_MODEL_ROUTER=true
NOVELFORGE_ENABLE_MODEL_HEALTH_ROUTING=true
NOVELFORGE_MODEL_HEALTH_ROUTING_LIMIT=200
NOVELFORGE_MODEL_PROBE_TIMEOUT=25
NOVELFORGE_MODEL_COOLDOWN_SECONDS=180
NOVELFORGE_EXTRACTOR_FAST_MODELS=gemini-3.5-flash,deepseek-ai/deepseek-v4-flash,mimo-v2.5-pro
NOVELFORGE_EXTRACTOR_DEEP_MODELS=gemini-3.1-pro-preview,deepseek-ai/deepseek-v4-pro
NOVELFORGE_EXTRACTOR_REPAIR_MODELS=gemini-3.1-pro-preview,deepseek-ai/deepseek-v4-pro,deepseek-ai/deepseek-v4-flash
NOVELFORGE_WRITER_FAST_MODELS=mimo-v2.5-pro,deepseek-ai/deepseek-v4-flash
NOVELFORGE_WRITER_PRO_MODELS=gemini-3.1-pro-preview,deepseek-ai/deepseek-v4-pro
NOVELFORGE_JUDGE_MODELS=gemini-3.1-pro-preview,deepseek-ai/deepseek-v4-pro

# Role runtime settings. Slow/high-quality models should use lower concurrency
# and longer timeout instead of being removed from the candidate pool.
NOVELFORGE_EXTRACTOR_FAST_TIMEOUT=180
NOVELFORGE_EXTRACTOR_FAST_CONCURRENCY=4
NOVELFORGE_EXTRACTOR_FAST_CHUNK_SIZE=2500
NOVELFORGE_EXTRACTOR_FAST_MAX_TOKENS=2500
NOVELFORGE_EXTRACTOR_DEEP_TIMEOUT=420
NOVELFORGE_EXTRACTOR_DEEP_CONCURRENCY=1
NOVELFORGE_EXTRACTOR_DEEP_CHUNK_SIZE=1800
NOVELFORGE_EXTRACTOR_DEEP_MAX_TOKENS=4000
NOVELFORGE_EXTRACTOR_REPAIR_TIMEOUT=300
NOVELFORGE_EXTRACTOR_REPAIR_CONCURRENCY=2
NOVELFORGE_EXTRACTOR_REPAIR_CHUNK_SIZE=2000
NOVELFORGE_EXTRACTOR_REPAIR_MAX_TOKENS=3000
# Optional hard override for saved import chapter split size. Leave empty to use extractor_fast chunk size.
NOVELFORGE_IMPORT_CHAPTER_MAX_CHARS=

# Storage. Recommended for internal/public deployment.
NOVELFORGE_DATA_DIR=./data
STORAGE_TYPE=content_db
USE_CONTENT_DATABASE=true
FILE_STORAGE_DIR=./data/file_storage
DATABASE_PATH=./data/novelforge.db
CONTENT_DATABASE_PATH=./data/novelforge_content.db

# Single-admin deployment security.
# Local development can keep auth disabled; internal/public deployment must set
# a strong admin password and a long random session secret.
NOVELFORGE_PUBLIC_DEPLOYMENT=false
NOVELFORGE_AUTH_REQUIRED=false
NOVELFORGE_ADMIN_PASSWORD=change-this-password
NOVELFORGE_SESSION_SECRET=replace-with-a-long-random-string
FRONTEND_ORIGIN=http://localhost:3010
NOVELFORGE_ALLOW_RUNTIME_OPENAI_OVERRIDES=true

# Extraction/runtime limits.
MAX_TEXT_LENGTH=500000
MAX_CHARACTERS=20
MIN_CONCURRENCY=2
MAX_CONCURRENCY=10
RPM_LIMIT=500
TPM_LIMIT=2000000
MAX_RETRIES=5
RETRY_BASE_DELAY=2.0
RETRY_MAX_DELAY=120.0

# Logging.
LOG_LEVEL=INFO
LOG_FILE=
STRUCTURED_LOGGING=true
